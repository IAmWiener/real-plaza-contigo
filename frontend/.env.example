# URL base de la API del backend. OPCIONAL.
#
# - Si se define con una URL no vacia (p. ej. http://localhost:4000), el
#   frontend dirige las operaciones de datos a la API en esa URL base.
# - Si se deja vacia, se comenta o se omite, el frontend opera en Modo_Demo:
#   datos mockeados y persistencia en localStorage. El Modo_Demo tambien se
#   activa como respaldo cuando la API no responde.
#
# No incluyas secretos ni credenciales en este archivo ni en el frontend.
VITE_API_BASE_URL=http://localhost:4000

# Clave de los basemaps de CARTO (estilo del mapa: Positron, Voyager, etc.).
# OPCIONAL. Gratuita, se solicita en https://carto.com/basemaps/apikey
#
# - Si se define, el mapa usa el estilo CARTO (gris claro Positron por defecto),
#   sin la marca de agua "API KEY REQUIRED".
# - Si se deja vacia, el mapa usa OpenStreetMap estandar como respaldo.
#
# Copia este valor a tu archivo .env local (no lo subas al repositorio).
VITE_CARTO_API_KEY=
