# Configuración del backend de Real Plaza Contigo.
# Copia este archivo a `.env` y ajusta los valores. NUNCA subas `.env` al repo.

# Cadena de conexión a PostgreSQL. La base debe tener la extensión PostGIS.
# Formato: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/realplaza?schema=public"

# Puerto del servidor HTTP en local.
PORT=4000

# Origen(es) permitido(s) por CORS (coma-separados). Debe incluir el del frontend.
CORS_ORIGIN="http://localhost:5173"

# Entorno de ejecución.
NODE_ENV=development
